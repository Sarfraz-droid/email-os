# Local dev values. For production deployment (Fly.io + Vercel) see DEPLOYMENT.md
# — set these as `fly secrets` instead of a .env file.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
# production: https://<backend>.fly.dev/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# OpenRouter (https://openrouter.ai/keys) — powers the chat agent.
# Model can be any OpenRouter-listed model id, e.g. anthropic/claude-sonnet-5,
# openai/gpt-5, google/gemini-2.5-pro, etc.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

PORT=8787

# --- Multi-user: database + sessions -----------------------------------------
# CockroachDB / Postgres connection string. Put the real SQL password here — not
# in source or chat. CockroachDB Cloud clusters use sslmode=verify-full.
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full
# Optional: path to a CA bundle if your cluster's verify-full needs one.
DATABASE_CA_CERT=

# Frontend origin: post-login redirect target, CORS allow-origin, and — when it
# is https:// — the trigger for Secure + SameSite=None session cookies.
# Exact scheme + host, no trailing slash. production: https://<frontend>.vercel.app
APP_BASE_URL=http://localhost:5173
# 32+ random bytes (e.g. `openssl rand -base64 48`). When set, Gmail tokens are
# encrypted at rest. Strongly recommended before deploying.
APP_SECRET=
SESSION_TTL_DAYS=30

# --- MCP (stdio) — single account -------------------------------------------
# Legacy single-account token file, used by the MCP server only when DATABASE_URL
# is unset.
TOKEN_FILE_PATH=./data/token.json
# When DATABASE_URL is set, which connected account the stdio MCP server acts as
# (by email). Defaults to the most recently updated account.
MCP_ACCOUNT_EMAIL=
