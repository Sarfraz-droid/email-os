# --- Google OAuth (see packages/backend/.env.example for the full set used by the backend) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# --- OpenRouter (chat agent LLM) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Backend server ---
PORT=8787

# --- Multi-user: database + sessions (see packages/backend/.env.example) ---
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full
APP_BASE_URL=http://localhost:5173
APP_SECRET=
