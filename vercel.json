{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run --filter frontend build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://email-os-backend.fly.dev/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://email-os-backend.fly.dev/auth/:path*" },
    { "source": "/oauth/:path*", "destination": "https://email-os-backend.fly.dev/oauth/:path*" },
    { "source": "/health", "destination": "https://email-os-backend.fly.dev/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
